# Python / environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
# Notebook / editor / operating system
.ipynb_checkpoints/
.ipython/
.vscode/
.idea/
.DS_Store
Thumbs.db
# Credentials / temporary work
.env
.env.*
!.env.example
work/
*.log
.streamlit/secrets.toml
~$*
# Data stays local until provenance and redistribution rights are reviewed
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
# Power BI temporary files
*.pbix.autosave
*.tmp

# Reviewed manual official uploads and their provenance notes are trackable
!/data/raw/manual/
/data/raw/manual/**
!/data/raw/manual/**/
!/data/raw/manual/.gitkeep
!/data/raw/manual/**/*.xlsx
!/data/raw/manual/**/*.XLSX
!/data/raw/manual/**/*.csv
!/data/raw/manual/**/*.CSV
!/data/raw/manual/**/*.metadata.json
!/data/raw/manual/**/*.source.md

# Audited outputs from the four user-uploaded originals, with unresolved licences documented
!/data/processed/audited/

# Scoped EDA artifacts are traceable derivatives of the pinned audited originals.
!/data/processed/eda/
