    ROW ( "Measure", "Land 2022 November Rows", "Actual", [Land 2022 November Rows], "Expected", 7501, "Pass", VAR Actual = [Land 2022 November Rows] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 7501 ), NOT ( ISBLANK ( 7501 ) ) && ABS ( Actual - (7501) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land 2022 December Rows", "Actual", [Land 2022 December Rows], "Expected", 5667, "Pass", VAR Actual = [Land 2022 December Rows] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 5667 ), NOT ( ISBLANK ( 5667 ) ) && ABS ( Actual - (5667) ) < 0.000000001 ) ),
