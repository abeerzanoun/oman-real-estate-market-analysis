-- Desktop DAX query view; measures must already exist. Case: unfiltered
-- Every Pass must be TRUE; blank and zero are intentionally different.
EVALUATE
UNION (
    ROW ( "Measure", "Land 2022 Reported Records", "Actual", [Land 2022 Reported Records], "Expected", 13168, "Pass", VAR Actual = [Land 2022 Reported Records] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 13168 ), NOT ( ISBLANK ( 13168 ) ) && ABS ( Actual - (13168) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land Oct 2024 Reported Records", "Actual", [Land Oct 2024 Reported Records], "Expected", 6024, "Pass", VAR Actual = [Land Oct 2024 Reported Records] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 6024 ), NOT ( ISBLANK ( 6024 ) ) && ABS ( Actual - (6024) ) < 0.000000001 ) ),
    ROW ( "Measure", "Muscat Brokerage Registrations", "Actual", [Muscat Brokerage Registrations], "Expected", 9366, "Pass", VAR Actual = [Muscat Brokerage Registrations] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 9366 ), NOT ( ISBLANK ( 9366 ) ) && ABS ( Actual - (9366) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land 2022 Geographic Share", "Actual", [Land 2022 Geographic Share], "Expected", 1.0, "Pass", VAR Actual = [Land 2022 Geographic Share] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 1.0 ), NOT ( ISBLANK ( 1.0 ) ) && ABS ( Actual - (1.0) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land Oct 2024 Geographic Share", "Actual", [Land Oct 2024 Geographic Share], "Expected", 1.0, "Pass", VAR Actual = [Land Oct 2024 Geographic Share] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 1.0 ), NOT ( ISBLANK ( 1.0 ) ) && ABS ( Actual - (1.0) ) < 0.000000001 ) ),
    ROW ( "Measure", "Muscat Brokerage Geographic Share", "Actual", [Muscat Brokerage Geographic Share], "Expected", 1.0, "Pass", VAR Actual = [Muscat Brokerage Geographic Share] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 1.0 ), NOT ( ISBLANK ( 1.0 ) ) && ABS ( Actual - (1.0) ) < 0.000000001 ) ),
    ROW ( "Measure", "Brokerage Property Use Share", "Actual", [Brokerage Property Use Share], "Expected", 1.0, "Pass", VAR Actual = [Brokerage Property Use Share] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 1.0 ), NOT ( ISBLANK ( 1.0 ) ) && ABS ( Actual - (1.0) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land 2022 Supplied Governorates", "Actual", [Land 2022 Supplied Governorates], "Expected", 11, "Pass", VAR Actual = [Land 2022 Supplied Governorates] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 11 ), NOT ( ISBLANK ( 11 ) ) && ABS ( Actual - (11) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land Oct 2024 Supplied Governorates", "Actual", [Land Oct 2024 Supplied Governorates], "Expected", 11, "Pass", VAR Actual = [Land Oct 2024 Supplied Governorates] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 11 ), NOT ( ISBLANK ( 11 ) ) && ABS ( Actual - (11) ) < 0.000000001 ) ),
    ROW ( "Measure", "Muscat Brokerage Supplied Months", "Actual", [Muscat Brokerage Supplied Months], "Expected", 9, "Pass", VAR Actual = [Muscat Brokerage Supplied Months] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 9 ), NOT ( ISBLANK ( 9 ) ) && ABS ( Actual - (9) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land 2022 Repeated Group Share", "Actual", [Land 2022 Repeated Group Share], "Expected", 0.4765340218712029, "Pass", VAR Actual = [Land 2022 Repeated Group Share] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 0.4765340218712029 ), NOT ( ISBLANK ( 0.4765340218712029 ) ) && ABS ( Actual - (0.4765340218712029) ) < 0.000000001 ) ),
    ROW ( "Measure", "Land Oct 2024 Repeated Group Share", "Actual", [Land Oct 2024 Repeated Group Share], "Expected", 0.0, "Pass", VAR Actual = [Land Oct 2024 Repeated Group Share] RETURN IF ( ISBLANK ( Actual ), ISBLANK ( 0.0 ), NOT ( ISBLANK ( 0.0 ) ) && ABS ( Actual - (0.0) ) < 0.000000001 ) ),
